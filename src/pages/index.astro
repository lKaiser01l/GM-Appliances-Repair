---
import '../styles/global.css';

// Cambia este número (código de país + número, sin + ni espacios). Perú = 51
const WHATSAPP = '15127733739';
const WHATSAPP_LABEL = '+1 (512)773-3739';
const wa = (msg: string) => `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(msg)}`;

const services = [
  { title: 'Washing machines and dryers', text: 'Leaks, noises, cycles that don’t finish.', icon: '<rect x="3" y="2" width="18" height="20" rx="2"/><circle cx="12" cy="13" r="5"/><path d="M7 6h.01M11 6h.01"/>' },
  { title: 'Refrigerators', text: "It doesn't cool, makes noise, or leaks water.", icon: '<rect x="5" y="2" width="14" height="20" rx="2"/><path d="M5 10h14M9 6v1M9 14v3"/>' },
  { title: 'Ovens and stoves', text: 'Burners, heating elements, and thermostats.', icon: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M7 6h.01M11 6h.01"/><rect x="7" y="12" width="10" height="6" rx="1"/>' },
  { title: 'Dishwasher', text: 'Leaks, noises, and drainage issues.', icon: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 8h18M7 5.5h.01"/><circle cx="12" cy="14.5" r="3.5"/>' },
  { title: 'Microwave', text: "It doesn't heat, has sparks, or the panel doesn't respond.", icon: '<rect x="2" y="5" width="20" height="14" rx="2"/><rect x="5" y="8" width="9" height="8" rx="1"/><path d="M18 9h.01M18 12h.01M18 15h.01"/>' },
  { title: 'Air-conditioning', text: "It doesn't cool, it leaks, or it won't turn on.", icon: '<rect x="2" y="4" width="20" height="8" rx="2"/><path d="M6 16v3M12 16v4M18 16v3M6 8h8"/>' },
];

const steps = [
  { title: 'Tell us what happens', text: 'Write to us or call and describe the issue. We respond the same day.' },
  { title: 'We do the diagnosis', text: 'A technician comes to your home, checks the appliance and gives you the price before starting.' },
  { title: 'Ready to proceed', text: 'We fix it, test that it works and leave you with a written guarantee.' },
];

const trust = [
  { title: 'Clear accounts', text: 'We tell you the cost before touching the appliance.' },
  { title: 'People to call', text: 'You talk to the person who served you, not a voicemail.' },
  { title: 'We take care of your home', text: 'We protect the floor and leave everything clean.' },
];

const faqs = [
  { q: 'How much does the diagnostic visit cost?', a: 'We give you the price when you schedule. If you decide to repair with us, the diagnostic is deducted from the total.' },
  { q: 'Can you repair my appliance at home?', a: 'Yes. Most repairs are done at your home. If the equipment requires a shop, we will explain it to you beforehand.' },
  { q: 'What happens if it cannot be repaired?', a: 'We will be honest with you and only charge for the visit. We do not sell repairs that do not make sense.' },
  { q: 'How long does it take for the technician to arrive?', a: 'Normally between 24 and 48 hours from when you schedule. Urgent cases are prioritized.' },
  { q: 'Do you provide a warranty for the repair?', a: 'Yes, each repair includes a written warranty on the work and parts used.' },
];

const brands = [
  "SAMSUNG", "LG", "Whirlpool", "BOSCH", "Electrolux", "Amana",
  "Frigidaire", "Hotpoint", "GE Monogram", "Panasonic", "Kenmore",
  "Maytag", "Jenn-Air", "Hisense", "U-Line", "Viking", "Miele",
  "Thor", "Dacor", "Wolf", "Sub-Zero", "Thermador", " "
];

---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Appliance Repair in Austin, TX </title>
    <meta name="description" content="We repair washing machines, refrigerators, ovens, and more. Verified technicians, clear pricing before we begin, and a written guarantee." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="header">
      <div class="wrap header__row">
        <a href="/" class="logo" aria-label="AppliancesReapirGM"><b>GM </b><span>Appliances</span></a>
        <nav class="nav" aria-label="Principal">
          <a href="#servicios">Services</a>
          <a href="#como-funciona">How it works</a>
          <a href="#preguntas">Questions</a>
        </nav>
        <a href={wa("Hello, I would like to schedule a visit.")} class="btn btn--primary" target="_blank" rel="noopener">Schedule Visit</a>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="wrap hero__grid">
          <div class="hero__copy">
            <span class="pill">In-home repair</span>
            <h1>Fast and Reliable Appliance Repair and Installation in Austin, Texas</h1>
            <p class="lead">Home Appliance Repair, Installation & HVAC Air conditioning</p>
            <div class="hero__actions">
              <a href={wa("Hola, quiero agendar una reparación.")} class="btn btn--primary" target="_blank" rel="noopener">Schedule Repair</a>
              <a href="#servicios" class="btn btn--ghost">View Services</a>
            </div>
            <ul class="hero__checks">
              <li>Clear Diagnosis</li>
              <li>Verified Technicians</li>
              <li>Written Guarantee</li>
            </ul>
          </div>
          <div class="photo">
            <img src="https://community.thriveglobal.com/wp-content/uploads/2021/05/Finding-an-Appliance-Service-Repair-Company-You-Trust.jpg" alt="Técnico revisando una lavadora en una cocina" onerror="this.remove()" />
            <div class="photo__badge"><i></i>Verified Technicians</div>
          </div>
        </div>
      </section>

      <section class="brands" aria-label="Marcas">
        <div class="wrap brands__row">
          <p>We repair the brands you already have at home</p>
        </div>

        <div class="carousel">
          <div class="carousel__track">
            <ul class="carousel__list">
              {brands.map((b) => <li>{b}</li>)}
            </ul>
            <ul class="carousel__list" aria-hidden="true">
              {brands.map((b) => <li>{b}</li>)}
            </ul>
          </div>
        </div>
      </section>

      <section class="section" id="servicios">
        <div class="wrap">
          <div class="split">
            <h2>If you use it daily, we’ll repair it.</h2>
            <p class="lead">We service the home appliances you can't live without.</p>
          </div>
          <div class="services">
            {services.map((s) => (
              <a href={wa(`Hola, necesito reparar: ${s.title}.`)} class="card" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" aria-hidden="true" set:html={s.icon} />
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="section section--navy" id="como-funciona">
        <div class="wrap">
          <h2>Getting back to normal, in 3 steps.</h2>
          <div class="steps">
            {steps.map((s, i) => (
              <div class="step">
                <small>Step {i + 1}</small>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="section">
        <div class="wrap trust">
          <div class="photo">
            <img src="https://oniria.pe/wp-content/uploads/2025/11/2-3.png" alt="Cocina luminosa con electrodomésticos funcionando" onerror="this.remove()" />
          </div>
          <div class="trust__copy">
            <h2>Repairing well is also about giving peace of mind.</h2>
            <ul class="trust__list">
              {trust.map((t) => (
                <li>
                  <span aria-hidden="true">✓</span>
                  <div><h3>{t.title}</h3><p>{t.text}</p></div>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <section class="section section--tint" id="preguntas">
        <div class="wrap faq">
          <div class="faq__intro">
            <h2>Everything clear, from the start.</h2>
            <p class="lead">We solve the most common questions before you schedule an appointment.</p>
          </div>
          <div class="faq__list">
            {faqs.map((f, i) => (
              <details open={i === 0}>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="section section--navy" id="contacto">
        <div class="wrap cta">
          <div>
            <h2>Your next repair, hassle-free.</h2>
            <p>Message us on WhatsApp and we'll confirm your visit within minutes.</p>
          </div>
          <a href={wa("Hola, quiero agendar una reparación.")} class="btn btn--light" target="_blank" rel="noopener">Message on WhatsApp</a>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="wrap">
        <div class="footer__grid">
          <div>
            <a href="/" class="logo" aria-label="OHappliances"><b>GM</b><span>appliances</span></a>
            <p style="margin-top:.75rem;max-width:34ch">Home appliance repair, with clear pricing and warranty.</p>
          </div>
          <div>
            <h4>Services</h4>
            <ul>
              <li><a href="#servicios">Washing Machines</a></li>
              <li><a href="#servicios">Refrigerators</a></li>
              <li><a href="#servicios">Ovens and Stoves</a></li>
            </ul>
          </div>
          <div>
            <h4>Contact</h4>
            <ul>
              <li><a href={wa("Hola, necesito ayuda.")} target="_blank" rel="noopener">WhatsApp {WHATSAPP_LABEL}</a></li>
              <li>Mon to Sat, 8:00 AM to 6:00 PM</li>
            </ul>
          </div>
        </div>
        <div class="footer__legal">
          <p>© {new Date().getFullYear()} GMappliances. All rights reserved.</p>
          <p><a href="#">Privacy</a> · <a href="#">Terms</a></p>
        </div>
      </div>
    </footer>

    <a href={wa("Hello, I need help with an appliance.")} class="wa-float" target="_blank" rel="noopener" aria-label="Escribir por WhatsApp">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12.04 2a9.9 9.9 0 0 0-8.47 15.04L2 22l5.1-1.34A9.9 9.9 0 1 0 12.04 2Zm0 18.1a8.2 8.2 0 0 1-4.18-1.14l-.3-.18-3.03.8.81-2.95-.2-.31a8.2 8.2 0 1 1 6.9 3.78Zm4.5-6.14c-.25-.12-1.46-.72-1.69-.8-.23-.08-.39-.12-.56.13-.16.25-.64.8-.78.97-.14.16-.29.18-.54.06a6.7 6.7 0 0 1-3.3-2.88c-.25-.43.25-.4.72-1.33.08-.16.04-.31-.02-.43-.06-.12-.56-1.35-.77-1.85-.2-.48-.4-.42-.56-.43h-.48c-.16 0-.43.06-.66.31-.23.25-.87.85-.87 2.07s.89 2.4 1.01 2.57c.12.16 1.75 2.67 4.24 3.75 1.58.68 2.2.74 3 .62.49-.07 1.46-.6 1.67-1.17.2-.58.2-1.07.14-1.17-.06-.1-.23-.16-.48-.28Z"/></svg>
      <span>WhatsApp</span>
    </a>
  </body>
</html>
