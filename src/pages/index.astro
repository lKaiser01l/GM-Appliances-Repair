---
import '../styles/global.css';

// Cambia este número (código de país + número, sin + ni espacios). Perú = 51
const WHATSAPP = '1(512)7133739';
const WHATSAPP_LABEL = '+1 (512)773-3739';
const wa = (msg: string) => `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(msg)}`;

const services = [
  { title: 'Lavadoras y secadoras', text: 'Fugas, ruidos, ciclos que no terminan.', icon: '<rect x="3" y="2" width="18" height="20" rx="2"/><circle cx="12" cy="13" r="5"/><path d="M7 6h.01M11 6h.01"/>' },
  { title: 'Refrigeradores', text: 'No enfría, hace ruido o gotea agua.', icon: '<rect x="5" y="2" width="14" height="20" rx="2"/><path d="M5 10h14M9 6v1M9 14v3"/>' },
  { title: 'Hornos y estufas', text: 'Quemadores, resistencias y termostatos.', icon: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M7 6h.01M11 6h.01"/><rect x="7" y="12" width="10" height="6" rx="1"/>' },
  { title: 'Lavavajillas', text: 'Drenaje, bombas y cierres de puerta.', icon: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 8h18M7 5.5h.01"/><circle cx="12" cy="14.5" r="3.5"/>' },
  { title: 'Microondas', text: 'No calienta, chispas o panel sin respuesta.', icon: '<rect x="2" y="5" width="20" height="14" rx="2"/><rect x="5" y="8" width="9" height="8" rx="1"/><path d="M18 9h.01M18 12h.01M18 15h.01"/>' },
  { title: 'Aire acondicionado', text: 'No enfría, gotea o no enciende.', icon: '<rect x="2" y="4" width="20" height="8" rx="2"/><path d="M6 16v3M12 16v4M18 16v3M6 8h8"/>' },
];

const steps = [
  { title: 'Cuéntanos qué pasa', text: 'Escríbenos o llámanos y describe la falla. Te respondemos el mismo día.' },
  { title: 'Hacemos el diagnóstico', text: 'Un técnico va a tu casa, revisa el equipo y te da el precio antes de empezar.' },
  { title: 'Listo para seguir', text: 'Reparamos, probamos que funcione y te dejamos la garantía por escrito.' },
];

const trust = [
  { title: 'Cuentas claras', text: 'Te decimos el costo antes de tocar el equipo.' },
  { title: 'Personas a quienes llamar', text: 'Hablas con quien te atendió, no con un buzón.' },
  { title: 'Cuidamos tu casa', text: 'Protegemos el piso y dejamos todo limpio.' },
];

const faqs = [
  { q: '¿Cuánto cuesta la visita de diagnóstico?', a: 'Te damos el precio al agendar. Si decides reparar con nosotros, el diagnóstico se descuenta del total.' },
  { q: '¿Pueden reparar mi electrodoméstico en casa?', a: 'Sí. La mayoría de las reparaciones se hacen en tu casa. Si el equipo requiere taller, te lo explicamos antes.' },
  { q: '¿Qué pasa si no se puede reparar?', a: 'Te lo decimos con honestidad y solo cobramos la visita. No te vendemos arreglos que no valen la pena.' },
  { q: '¿Cuánto tarda en llegar el técnico?', a: 'Normalmente entre 24 y 48 horas desde que agendas. Las urgencias se atienden primero.' },
  { q: '¿Dan garantía por la reparación?', a: 'Sí, cada reparación incluye garantía por escrito sobre el trabajo y los repuestos usados.' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AppliancesReapirGM | Reparación de electrodomésticos a domicilio</title>
    <meta name="description" content="Reparamos lavadoras, refrigeradores, hornos y más. Técnicos verificados, precio claro antes de empezar y garantía por escrito." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="header">
      <div class="wrap header__row">
        <a href="/" class="logo" aria-label="AppliancesReapirGM"><b>GM</b><span>Appliances</span></a>
        <nav class="nav" aria-label="Principal">
          <a href="#servicios">Servicios</a>
          <a href="#como-funciona">Cómo funciona</a>
          <a href="#preguntas">Preguntas</a>
        </nav>
        <a href={wa("Hola, quiero agendar una visita.")} class="btn btn--primary" target="_blank" rel="noopener">Agendar visita</a>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="wrap hero__grid">
          <div class="hero__copy">
            <span class="pill">Reparación a domicilio</span>
            <h1>Tu casa no para. Nosotros tampoco.</h1>
            <p class="lead">Reparamos tus electrodomésticos sin complicaciones: te decimos qué tiene, cuánto cuesta y cuándo queda listo.</p>
            <div class="hero__actions">
              <a href={wa("Hola, quiero agendar una reparación.")} class="btn btn--primary" target="_blank" rel="noopener">Agendar reparación</a>
              <a href="#servicios" class="btn btn--ghost">Ver servicios</a>
            </div>
            <ul class="hero__checks">
              <li>Diagnóstico claro</li>
              <li>Técnicos verificados</li>
              <li>Garantía escrita</li>
            </ul>
          </div>
          <div class="photo">
            <img src="https://community.thriveglobal.com/wp-content/uploads/2021/05/Finding-an-Appliance-Service-Repair-Company-You-Trust.jpg" alt="Técnico revisando una lavadora en una cocina" onerror="this.remove()" />
            <div class="photo__badge"><i></i>Técnico en camino</div>
          </div>
        </div>
      </section>

      <section class="brands" aria-label="Marcas">
        <div class="wrap brands__row">
          <p>Reparamos las marcas que ya tienes en casa</p>
          <ul>
            <li>SAMSUNG</li><li>LG</li><li>Whirlpool</li><li>BOSCH</li><li>Electrolux</li>
          </ul>
        </div>
      </section>

      <section class="section" id="servicios">
        <div class="wrap">
          <div class="split">
            <h2>Si lo usas a diario, nosotros lo reparamos.</h2>
            <p class="lead">Atendemos los electrodomésticos que no pueden faltar en tu rutina.</p>
          </div>
          <div class="services">
            {services.map((s) => (
              <a href={wa(`Hola, necesito reparar: ${s.title}.`)} class="card" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" aria-hidden="true" set:html={s.icon} />
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="section section--navy" id="como-funciona">
        <div class="wrap">
          <h2>Volver a la normalidad, en 3 pasos.</h2>
          <div class="steps">
            {steps.map((s, i) => (
              <div class="step">
                <small>Paso {i + 1}</small>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="section">
        <div class="wrap trust">
          <div class="photo">
            <img src="https://oniria.pe/wp-content/uploads/2025/11/2-3.png" alt="Cocina luminosa con electrodomésticos funcionando" onerror="this.remove()" />
          </div>
          <div class="trust__copy">
            <h2>Reparar bien también es dar tranquilidad.</h2>
            <ul class="trust__list">
              {trust.map((t) => (
                <li>
                  <span aria-hidden="true">✓</span>
                  <div><h3>{t.title}</h3><p>{t.text}</p></div>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <section class="section section--tint" id="preguntas">
        <div class="wrap faq">
          <div class="faq__intro">
            <h2>Todo claro, desde el inicio.</h2>
            <p class="lead">Resolvemos las dudas más comunes antes de que agendes.</p>
            <a href={wa("Hola, tengo una consulta antes de agendar.")} target="_blank" rel="noopener">Hablar con una persona</a>
          </div>
          <div class="faq__list">
            {faqs.map((f, i) => (
              <details open={i === 0}>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="section section--navy" id="contacto">
        <div class="wrap cta">
          <div>
            <h2>Tu próxima reparación, sin complicaciones.</h2>
            <p>Escríbenos por WhatsApp y te confirmamos la visita en minutos.</p>
          </div>
          <a href={wa("Hola, quiero agendar una reparación.")} class="btn btn--light" target="_blank" rel="noopener">Escribir por WhatsApp</a>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="wrap">
        <div class="footer__grid">
          <div>
            <a href="/" class="logo" aria-label="OHappliances"><b>OH</b><span>appliances</span></a>
            <p style="margin-top:.75rem;max-width:34ch">Reparación de electrodomésticos a domicilio, con precio claro y garantía.</p>
          </div>
          <div>
            <h4>Servicios</h4>
            <ul>
              <li><a href="#servicios">Lavadoras</a></li>
              <li><a href="#servicios">Refrigeradores</a></li>
              <li><a href="#servicios">Hornos y estufas</a></li>
            </ul>
          </div>
          <div>
            <h4>Contacto</h4>
            <ul>
              <li><a href={wa("Hola, necesito ayuda.")} target="_blank" rel="noopener">WhatsApp {WHATSAPP_LABEL}</a></li>
              <li>Lun a Sáb, 8:00 a 18:00</li>
            </ul>
          </div>
        </div>
        <div class="footer__legal">
          <p>© {new Date().getFullYear()} OHappliances. Todos los derechos reservados.</p>
          <p><a href="#">Privacidad</a> · <a href="#">Términos</a></p>
        </div>
      </div>
    </footer>

    <a href={wa("Hola, necesito ayuda con un electrodoméstico.")} class="wa-float" target="_blank" rel="noopener" aria-label="Escribir por WhatsApp">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12.04 2a9.9 9.9 0 0 0-8.47 15.04L2 22l5.1-1.34A9.9 9.9 0 1 0 12.04 2Zm0 18.1a8.2 8.2 0 0 1-4.18-1.14l-.3-.18-3.03.8.81-2.95-.2-.31a8.2 8.2 0 1 1 6.9 3.78Zm4.5-6.14c-.25-.12-1.46-.72-1.69-.8-.23-.08-.39-.12-.56.13-.16.25-.64.8-.78.97-.14.16-.29.18-.54.06a6.7 6.7 0 0 1-3.3-2.88c-.25-.43.25-.4.72-1.33.08-.16.04-.31-.02-.43-.06-.12-.56-1.35-.77-1.85-.2-.48-.4-.42-.56-.43h-.48c-.16 0-.43.06-.66.31-.23.25-.87.85-.87 2.07s.89 2.4 1.01 2.57c.12.16 1.75 2.67 4.24 3.75 1.58.68 2.2.74 3 .62.49-.07 1.46-.6 1.67-1.17.2-.58.2-1.07.14-1.17-.06-.1-.23-.16-.48-.28Z"/></svg>
      <span>WhatsApp</span>
    </a>
  </body>
</html>
